<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShortURL</title>
    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --bg: #f5f2ee;
            --panel: #ffffff;
            --panel-soft: #f8f5f2;
            --line: #ddd3ca;
            --text: #1f1b18;
            --muted: #6b625d;
            --orange: #f97316;
            --orange-dark: #ea580c;
            --orange-soft: #fff4eb;
            --success-bg: #f0fdf4;
            --success-text: #166534;
            --error-bg: #fef2f2;
            --error-text: #9f1239;
            --shadow: 0 6px 0 rgba(31, 27, 24, 0.08);
        }

        html,
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--text);
        }

        body {
            min-height: 100vh;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .container {
            max-width: 1180px;
            margin: 0 auto;
            padding: 24px 20px 64px;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 0 30px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

        .brand-mark {
            width: 28px;
            height: 28px;
            background: var(--orange);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            font-weight: 700;
            border: 2px solid #1f1b18;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 0 16px;
            border: 2px solid var(--text);
            background: var(--orange);
            color: #fff;
            font-weight: 700;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: 0.15s ease;
            box-shadow: var(--shadow);
            border-radius: 0;
        }

        .btn:hover {
            transform: translateY(-1px);
            background: var(--orange-dark);
        }

        .btn-secondary {
            background: var(--panel);
            color: var(--text);
        }

        .btn-ghost {
            background: transparent;
            color: var(--text);
            box-shadow: none;
        }

        .hero {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 20px;
            align-items: stretch;
        }

        .hero-copy,
        .panel {
            background: var(--panel);
            border: 2px solid var(--line);
            box-shadow: var(--shadow);
            padding: 28px;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(31, 27, 24, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 40;
        }

        .modal-overlay.hidden {
            display: none;
        }

        .auth-modal {
            width: min(100%, 440px);
            background: var(--panel);
            border: 2px solid var(--text);
            box-shadow: 0 12px 0 rgba(31, 27, 24, 0.12);
            position: relative;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 20px 12px;
            border-bottom: 2px solid var(--line);
        }

        .modal-header h3 {
            margin: 0;
            font-size: 1.1rem;
        }

        .close-btn {
            border: 2px solid var(--text);
            background: var(--panel);
            color: var(--text);
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
        }

        .auth-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-bottom: 2px solid var(--line);
        }

        .auth-tab {
            border: none;
            border-bottom: 3px solid transparent;
            background: var(--panel-soft);
            color: var(--muted);
            font-weight: 700;
            min-height: 48px;
            cursor: pointer;
        }

        .auth-tab.active {
            background: var(--panel);
            color: var(--text);
            border-bottom-color: var(--orange);
        }

        .auth-body {
            padding: 20px;
        }

        .auth-form {
            display: none;
        }

        .auth-form.active {
            display: block;
        }

        .eyebrow {
            display: inline-block;
            padding: 7px 10px;
            background: var(--orange-soft);
            color: var(--orange-dark);
            border: 1px solid #f6d5b6;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 14px;
        }

        h1 {
            margin: 0 0 12px;
            font-size: clamp(2.2rem, 5vw, 4.2rem);
            line-height: 0.96;
            letter-spacing: -0.06em;
        }

        .lead {
            margin: 0 0 22px;
            color: var(--muted);
            font-size: 1.04rem;
            line-height: 1.6;
            max-width: 560px;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(120px, 1fr));
            gap: 12px;
        }

        .stat {
            background: var(--panel-soft);
            border: 1px solid var(--line);
            padding: 14px 16px;
        }

        .stat strong {
            display: block;
            font-size: 1.5rem;
            margin-bottom: 4px;
        }

        .stat span {
            color: var(--muted);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .form-grid {
            display: grid;
            gap: 22px;
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 18px;
        }

        .panel-header h2 {
            margin: 0;
            font-size: 1.1rem;
            letter-spacing: -0.04em;
        }

        .tag {
            padding: 6px 8px;
            background: var(--orange-soft);
            color: var(--orange-dark);
            font-size: 0.72rem;
            font-weight: 700;
            border: 1px solid #f3d4b2;
        }

        .label {
            display: block;
            margin-bottom: 8px;
            color: var(--muted);
            font-size: 0.8rem;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        input {
            width: 100%;
            min-height: 46px;
            background: #fff;
            border: 2px solid var(--line);
            padding: 0 12px;
            color: var(--text);
            font-size: 0.98rem;
            border-radius: 0;
            outline: none;
        }

        input:focus {
            border-color: var(--orange);
        }

        .field {
            margin-bottom: 14px;
        }

        .inline-row {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .inline-row .btn {
            flex: 0 0 auto;
        }

        .status {
            min-height: 20px;
            margin-top: 14px;
            font-size: 0.9rem;
            color: var(--muted);
        }

        .status.error {
            color: var(--error-text);
        }

        .status.success {
            color: var(--success-text);
        }

        .muted-note {
            margin-top: 10px;
            color: var(--muted);
            font-size: 0.8rem;
            line-height: 1.5;
        }

        .result-box {
            display: none;
            margin-top: 18px;
            border: 2px solid var(--line);
            background: var(--panel-soft);
            padding: 16px;
        }

        .result-box.visible {
            display: block;
        }

        .result-box.error {
            background: var(--error-bg);
            border-color: #f6c6c6;
            color: var(--error-text);
        }

        .result-box.success {
            background: var(--success-bg);
            border-color: #bbf7d0;
            color: var(--success-text);
        }

        .result-row {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            justify-content: space-between;
        }

        .result-link {
            color: var(--text);
            font-weight: 700;
            word-break: break-all;
        }

        .qr-box {
            margin-top: 14px;
            display: flex;
            align-items: center;
            gap: 16px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
        }

        .qr-box img {
            width: 110px;
            height: 110px;
            border: 2px solid var(--text);
            background: #fff;
            padding: 6px;
        }

        .copy-btn {
            background: var(--panel);
            color: var(--text);
            border: 2px solid var(--text);
            box-shadow: none;
        }

        .hidden {
            display: none !important;
        }

        @media (max-width: 840px) {
            .hero {
                grid-template-columns: 1fr;
            }

            .stats {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 540px) {
            .topbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .nav-actions {
                width: 100%;
                justify-content: space-between;
            }

            .stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <header class="topbar">
            <div class="brand">
                <span class="brand-mark">S</span>
                <span>ShortURL</span>
            </div>

            <div class="nav-actions">
                <button id="loginToggleBtn" class="btn btn-secondary" type="button">Login</button>
                <button id="signupToggleBtn" class="btn btn-ghost" type="button">Sign up</button>
                <button id="logoutBtn" class="btn btn-ghost hidden" type="button">Logout</button>
            </div>
        </header>

        <main class="hero">
            <section class="hero-copy">
                <span class="eyebrow">Free & simple</span>
                <h1>Turn long links into short ones.</h1>
                <p class="lead">Create clean shortened links in seconds. Use the free tool for instant sharing, or log
                    in to unlock protected branded URLs with QR codes and tracking.</p>

                <div class="hero-actions">
                    <button class="btn" type="button" onclick="document.getElementById('quickUrl').focus()">Create free
                        link</button>
                    <button class="btn btn-secondary" type="button"
                        onclick="document.getElementById('loginToggleBtn').click()">Login</button>
                </div>

                <div class="stats">
                    <div class="stat">
                        <strong>1 click</strong>
                        <span>Fast link</span>
                    </div>
                    <div class="stat">
                        <strong>QR</strong>
                        <span>Image ready</span>
                    </div>
                    <div class="stat">
                        <strong>Live</strong>
                        <span>Track visits</span>
                    </div>
                </div>
            </section>

            <section class="form-grid">
                <div id="authModal" class="modal-overlay hidden" aria-hidden="true">
                    <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="authModalTitle">
                        <div class="modal-header">
                            <h3 id="authModalTitle">Account</h3>
                            <button class="close-btn" type="button" aria-label="Close modal"
                                id="closeAuthModal">×</button>
                        </div>

                        <div class="auth-tabs">
                            <button class="auth-tab active" type="button" data-mode="login">Login</button>
                            <button class="auth-tab" type="button" data-mode="signup">Sign up</button>
                        </div>

                        <div class="auth-body">
                            <form id="loginForm" class="auth-form active">
                                <div class="field">
                                    <label class="label" for="loginEmail">Email</label>
                                    <input id="loginEmail" name="email" type="email" placeholder="you@example.com"
                                        required>
                                </div>

                                <div class="field">
                                    <label class="label" for="loginPassword">Password</label>
                                    <input id="loginPassword" name="password" type="password"
                                        placeholder="Your password" required>
                                </div>

                                <button class="btn" type="submit">Login</button>
                                <div id="authStatus" class="status"></div>
                            </form>

                            <form id="signupForm" class="auth-form">
                                <div class="field">
                                    <label class="label" for="signupName">Name</label>
                                    <input id="signupName" name="name" type="text" placeholder="Your name" required>
                                </div>

                                <div class="field">
                                    <label class="label" for="signupEmail">Email</label>
                                    <input id="signupEmail" name="email" type="email" placeholder="you@example.com"
                                        required>
                                </div>

                                <div class="field">
                                    <label class="label" for="signupPassword">Password</label>
                                    <input id="signupPassword" name="password" type="password"
                                        placeholder="Create a password" required>
                                </div>

                                <button class="btn" type="submit">Create account</button>
                                <div id="signupStatus" class="status"></div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <h2>Free URL Shortener</h2>
                        <span class="tag">Free</span>
                    </div>

                    <form id="quickForm">
                        <div class="field">
                            <label class="label" for="quickUrl">Original URL</label>
                            <input id="quickUrl" name="url" type="url" placeholder="https://example.com" required>
                        </div>

                        <div class="field">
                            <label class="label" for="quickAlias">Custom alias (optional)</label>
                            <input id="quickAlias" name="customAlias" type="text" placeholder="my-link">
                        </div>

                        <button class="btn" type="submit">Generate short URL</button>
                    </form>
                    <div id="quickResult" class="result-box"></div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <h2>Protected URL</h2>
                        <span class="tag">Login required</span>
                    </div>

                    <p class="muted-note" id="protectedHint">Log in to create a protected link with QR code and visitor
                        tracking.</p>

                    <form id="protectedForm">
                        <div class="field">
                            <label class="label" for="protectedUrl">Original URL</label>
                            <input id="protectedUrl" name="url" type="url" placeholder="https://example.com" required
                                disabled>
                        </div>

                        <div class="field">
                            <label class="label" for="protectedAlias">Custom alias (optional)</label>
                            <input id="protectedAlias" name="customAlias" type="text" placeholder="vip-link" disabled>
                        </div>

                        <button class="btn" type="submit" id="protectedSubmit" disabled>Generate protected URL</button>
                    </form>
                    <div id="protectedResult" class="result-box"></div>
                </div>
            </section>
        </main>
    </div>

    <script>
        const tokenKey = 'url-shortener-token';
        const authModal = document.getElementById('authModal');
        const loginToggleBtn = document.getElementById('loginToggleBtn');
        const signupToggleBtn = document.getElementById('signupToggleBtn');
        const closeAuthModalBtn = document.getElementById('closeAuthModal');
        const logoutBtn = document.getElementById('logoutBtn');
        const authStatus = document.getElementById('authStatus');
        const signupStatus = document.getElementById('signupStatus');
        const protectedForm = document.getElementById('protectedForm');
        const protectedFields = protectedForm.querySelectorAll('input, button');
        const protectedHint = document.getElementById('protectedHint');

        function getToken() {
            return localStorage.getItem(tokenKey);
        }

        function setAuthUi(isLoggedIn, userName = '') {
            if (isLoggedIn) {
                loginToggleBtn.textContent = userName ? `Logged in as ${userName}` : 'Logged in';
                signupToggleBtn.classList.add('hidden');
                logoutBtn.classList.remove('hidden');
                protectedHint.textContent = 'Your protected URL is ready to create.';
                protectedFields.forEach((field) => field.disabled = false);
            } else {
                loginToggleBtn.textContent = 'Login';
                signupToggleBtn.classList.remove('hidden');
                logoutBtn.classList.add('hidden');
                protectedHint.textContent = 'Log in to create a protected link with QR code and visitor tracking.';
                protectedFields.forEach((field) => field.disabled = true);
            }
        }

        function showResult(targetId, html, type = 'success') {
            const result = document.getElementById(targetId);
            result.className = `result-box visible ${type}`;
            result.innerHTML = html;
            bindCopyButtons(result);
        }

        function bindCopyButtons(container) {
            container.querySelectorAll('[data-copy]').forEach((button) => {
                button.addEventListener('click', async () => {
                    const value = button.getAttribute('data-copy');
                    try {
                        await navigator.clipboard.writeText(value);
                        button.textContent = 'Copied';
                        setTimeout(() => { button.textContent = 'Copy'; }, 1200);
                    } catch (error) {
                        button.textContent = 'Failed';
                    }
                });
            });
        }

        function openAuthModal(mode = 'login') {
            authModal.classList.remove('hidden');
            authModal.setAttribute('aria-hidden', 'false');

            document.querySelectorAll('.auth-tab').forEach((tab) => {
                const isActive = tab.dataset.mode === mode;
                tab.classList.toggle('active', isActive);
            });

            document.querySelectorAll('.auth-form').forEach((form) => {
                form.classList.toggle('active', form.id === (mode === 'login' ? 'loginForm' : 'signupForm'));
            });
        }

        function closeAuthModal() {
            authModal.classList.add('hidden');
            authModal.setAttribute('aria-hidden', 'true');
        }

        document.querySelectorAll('.auth-tab').forEach((tab) => {
            tab.addEventListener('click', () => {
                openAuthModal(tab.dataset.mode);
            });
        });

        closeAuthModalBtn.addEventListener('click', closeAuthModal);
        authModal.addEventListener('click', (event) => {
            if (event.target === authModal) closeAuthModal();
        });

        loginToggleBtn.addEventListener('click', () => {
            if (getToken()) return;
            openAuthModal('login');
        });

        signupToggleBtn.addEventListener('click', () => {
            openAuthModal('signup');
        });

        logoutBtn.addEventListener('click', () => {
            localStorage.removeItem(tokenKey);
            setAuthUi(false);
            authStatus.textContent = 'Logged out';
            authStatus.className = 'status';
            signupStatus.textContent = '';
            signupStatus.className = 'status';
        });

        document.getElementById('loginForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const payload = Object.fromEntries(new FormData(event.currentTarget).entries());

            const response = await fetch('/user/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            const data = await response.json();
            if (!response.ok) {
                authStatus.className = 'status error';
                authStatus.textContent = data.error || 'Login failed';
                return;
            }

            if (data.token) {
                localStorage.setItem(tokenKey, data.token);
                authStatus.className = 'status success';
                authStatus.textContent = `Welcome back, ${data.user?.name || 'User'}`;
                setAuthUi(true, data.user?.name || 'User');
                closeAuthModal();
            }
        });

        document.getElementById('signupForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const payload = Object.fromEntries(new FormData(event.currentTarget).entries());

            const response = await fetch('/user/signup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            const data = await response.json();
            if (!response.ok) {
                signupStatus.className = 'status error';
                signupStatus.textContent = data.error || 'Signup failed';
                return;
            }

            signupStatus.className = 'status success';
            signupStatus.textContent = data.message || 'Signup successful';
            event.currentTarget.reset();
            openAuthModal('login');
            authStatus.className = 'status';
            authStatus.textContent = 'Account created. Please login.';
        });

        document.getElementById('quickForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const payload = Object.fromEntries(new FormData(event.currentTarget).entries());

            const response = await fetch('/url/quick', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            const data = await response.json();
            if (!response.ok) {
                showResult('quickResult', data.error || 'Request failed.', 'error');
                return;
            }

            showResult('quickResult', `
                <div class="result-row">
                    <a class="result-link" href="${data.shortURL}" target="_blank">${data.shortURL}</a>
                    <button class="btn copy-btn" type="button" data-copy="${data.shortURL}">Copy</button>
                </div>
                <div class="qr-box">
                    <img src="${data.qrCode}" alt="QR code for ${data.shortURL}">
                    <div>
                        <div><strong>QR code ready</strong></div>
                        <a href="${data.qrCode}" target="_blank">Open image</a>
                    </div>
                </div>
            `, 'success');
        });

        document.getElementById('protectedForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const token = getToken();
            if (!token) {
                showResult('protectedResult', 'Please login before creating a protected URL.', 'error');
                openAuthModal('login');
                return;
            }

            const payload = Object.fromEntries(new FormData(event.currentTarget).entries());
            const response = await fetch('/url', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify(payload),
            });

            const data = await response.json();
            if (!response.ok) {
                showResult('protectedResult', data.error || 'Protected request failed.', 'error');
                return;
            }

            showResult('protectedResult', `
                <div class="result-row">
                    <a class="result-link" href="${data.shortURL}" target="_blank">${data.shortURL}</a>
                    <button class="btn copy-btn" type="button" data-copy="${data.shortURL}">Copy</button>
                </div>
                <div class="qr-box">
                    <img src="${data.qrCode}" alt="QR code for ${data.shortURL}">
                    <div>
                        <div><strong>Protected QR ready</strong></div>
                        <a href="${data.qrCode}" target="_blank">Open image</a>
                    </div>
                </div>
            `, 'success');
        });

        setAuthUi(Boolean(getToken()));
    </script>
</body>

</html>