<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener Dashboard</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #0f172a, #111827);
            color: #e5e7eb;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px 80px;
        }

        .hero {
            text-align: center;
            margin-bottom: 30px;
        }

        .hero h1 {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .hero p {
            color: #cbd5e1;
            font-size: 1.05rem;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .card {
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.25);
            border-radius: 16px;
            padding: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }

        label {
            display: block;
            font-size: 0.9rem;
            margin-bottom: 8px;
            color: #cbd5e1;
        }

        input,
        button {
            width: 100%;
            padding: 12px 14px;
            border-radius: 10px;
            border: 1px solid #334155;
            margin-bottom: 12px;
            font-size: 1rem;
        }

        input {
            background: #0f172a;
            color: white;
        }

        button {
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            color: white;
            border: none;
            font-weight: 700;
            cursor: pointer;
        }

        button:hover {
            filter: brightness(1.1);
        }

        .secondary {
            background: #1f2937;
        }

        .result-box {
            margin-top: 16px;
            padding: 12px;
            border-radius: 8px;
            background: rgba(34, 197, 94, 0.1);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: #dcfce7;
            display: none;
        }

        .result-box.visible {
            display: block;
        }

        .status {
            margin-top: 12px;
            color: #fcd34d;
            min-height: 24px;
            font-size: 0.9rem;
        }

        .small-text {
            font-size: 0.8rem;
            color: #94a3b8;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="hero">
            <h1>URL Shortener</h1>
            <p>Quick mode + protected dashboard mode with analytics and QR support.</p>
        </div>

        <div class="grid">
            <section class="card">
                <h2>Quick Mode</h2>
                <p class="small-text">Create a short URL without login.</p>
                <form id="quickForm">
                    <label for="quickUrl">Original URL</label>
                    <input id="quickUrl" name="url" type="url" placeholder="https://example.com" required>

                    <label for="quickAlias">Custom alias (optional)</label>
                    <input id="quickAlias" name="customAlias" type="text" placeholder="my-link">

                    <button type="submit">Generate short URL</button>
                </form>
                <div id="quickResult" class="result-box"></div>
            </section>

            <section class="card">
                <h2>Account Access</h2>
                <form id="signupForm">
                    <label for="signupName">Name</label>
                    <input id="signupName" name="name" type="text" placeholder="John Doe" required>

                    <label for="signupEmail">Email</label>
                    <input id="signupEmail" name="email" type="email" placeholder="john@example.com" required>

                    <label for="signupPassword">Password</label>
                    <input id="signupPassword" name="password" type="password" placeholder="••••••••" required>

                    <button type="submit" class="secondary">Sign Up</button>
                </form>

                <form id="loginForm" style="margin-top: 20px;">
                    <label for="loginEmail">Email</label>
                    <input id="loginEmail" name="email" type="email" placeholder="john@example.com" required>

                    <label for="loginPassword">Password</label>
                    <input id="loginPassword" name="password" type="password" placeholder="••••••••" required>

                    <button type="submit">Login</button>
                </form>
                <div id="authStatus" class="status"></div>
            </section>

            <section class="card">
                <h2>Protected Mode</h2>
                <p class="small-text">Use this mode after login to create short URLs with token-based authorization.</p>
                <form id="protectedForm">
                    <label for="protectedUrl">Original URL</label>
                    <input id="protectedUrl" name="url" type="url" placeholder="https://example.com" required>

                    <label for="protectedAlias">Custom alias (optional)</label>
                    <input id="protectedAlias" name="customAlias" type="text" placeholder="vip-link">

                    <button type="submit">Create with token</button>
                </form>
                <div id="protectedResult" class="result-box"></div>
            </section>

            <section class="card">
                <h2>Analytics</h2>
                <label for="analyticsShortId">Short ID</label>
                <input id="analyticsShortId" type="text" placeholder="abc123">
                <button id="analyticsButton" type="button">View analytics</button>
                <div id="analyticsResult" class="result-box"></div>
            </section>
        </div>
    </div>

    <script>
        const authStatus = document.getElementById('authStatus');
        const tokenKey = 'url-shortener-token';

        function setToken(token) {
            if (token) {
                localStorage.setItem(tokenKey, token);
                authStatus.textContent = 'Logged in successfully.';
            }
        }

        function getToken() {
            return localStorage.getItem(tokenKey);
        }

        function showResult(elementId, message, isError = false) {
            const result = document.getElementById(elementId);
            result.innerHTML = message;
            result.classList.add('visible');
            result.style.background = isError ? 'rgba(239, 68, 68, 0.12)' : 'rgba(34, 197, 94, 0.1)';
            result.style.borderColor = isError ? 'rgba(239, 68, 68, 0.5)' : 'rgba(34, 197, 94, 0.5)';
            result.style.color = isError ? '#fecaca' : '#dcfce7';
        }

        document.getElementById('signupForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const form = event.currentTarget;
            const payload = Object.fromEntries(new FormData(form).entries());

            const response = await fetch('/user/signup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            const data = await response.json();
            authStatus.textContent = data.error || data.message || 'Signup complete.';
        });

        document.getElementById('loginForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const form = event.currentTarget;
            const payload = Object.fromEntries(new FormData(form).entries());

            const response = await fetch('/user/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            const data = await response.json();
            if (data.token) {
                setToken(data.token);
            }
            authStatus.textContent = data.error || data.message || 'Login successful.';
        });

        document.getElementById('quickForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const payload = Object.fromEntries(new FormData(event.currentTarget).entries());

            const response = await fetch('/url/quick', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
            });

            const data = await response.json();
            if (!response.ok) {
                showResult('quickResult', data.error || 'Request failed.', true);
                return;
            }

            showResult('quickResult', `<strong>Short URL:</strong> <a href="${data.shortURL}" target="_blank" style="color:#fff;">${data.shortURL}</a><br><strong>QR:</strong> <a href="${data.qrCode}" target="_blank" style="color:#fff;">${data.qrCode}</a>`);
        });

        document.getElementById('protectedForm').addEventListener('submit', async (event) => {
            event.preventDefault();
            const payload = Object.fromEntries(new FormData(event.currentTarget).entries());
            const token = getToken();

            const response = await fetch('/url', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    ...(token ? { Authorization: `Bearer ${token}` } : {}),
                },
                body: JSON.stringify(payload),
            });

            const data = await response.json();
            if (!response.ok) {
                showResult('protectedResult', data.error || 'Protected request failed.', true);
                return;
            }

            showResult('protectedResult', `<strong>Short URL:</strong> <a href="${data.shortURL}" target="_blank" style="color:#fff;">${data.shortURL}</a><br><strong>QR:</strong> <a href="${data.qrCode}" target="_blank" style="color:#fff;">${data.qrCode}</a>`);
        });

        document.getElementById('analyticsButton').addEventListener('click', async () => {
            const shortId = document.getElementById('analyticsShortId').value.trim();
            if (!shortId) {
                showResult('analyticsResult', 'Please enter a short ID.', true);
                return;
            }

            const response = await fetch(`/url/analytics/${shortId}`);
            const data = await response.json();

            if (!response.ok) {
                showResult('analyticsResult', data.error || 'Analytics not found.', true);
                return;
            }

            showResult('analyticsResult', `<strong>Total Clicks:</strong> ${data.totalClicks}<br><pre style="white-space:pre-wrap; color:#fff;">${JSON.stringify(data.analytics, null, 2)}</pre>`);
        });
    </script>
</body>

</html>